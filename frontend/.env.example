# Leafie calls the same backend as the storefront. AI keys belong on the backend.
VITE_API_BASE_URL=http://localhost:8000

# Authentication. Leave local until Cognito is enabled in the backend.
VITE_AUTH_PROVIDER=local
# VITE_COGNITO_REGION=ap-southeast-1
# VITE_COGNITO_USER_POOL_ID=
# VITE_COGNITO_APP_CLIENT_ID=
# VITE_COGNITO_DOMAIN=https://your-domain.auth.ap-southeast-1.amazoncognito.com
# VITE_COGNITO_SOCIAL_PROVIDERS=Google,Facebook
