            "orders/order_service.py",
            "orders/types.py",
            "orders/voucher_service.py"
          ]
        }
      },
      "patterns": [
        "router-centric FastAPI with incremental service-layer refactor",
        "SQLAlchemy ORM over existing PostgreSQL schema",
        "Pydantic request/response models defined mostly inside routers",
        "role-based access via FastAPI dependencies"
