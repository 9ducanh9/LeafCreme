  "workflows": {
    "auth": [
      "register user",
      "login with username or email",
      "store access and refresh tokens in frontend local storage",
      "fetch current user via /auth/me"
    ],
    "order_creation": [
      "frontend checkout builds OrderCreate payload",
      "backend OrderService validates order",
      "FEFO allocates stock by variant from earliest-expiry lots",
      "ChiTietDonHang lines are created per allocated lot",
      "voucher logic applies discounts when provided",
      "order totals are persisted and response returned"
    ],
    "order_cancellation": [
      "OrderService checks permissions and current status",
      "for each ChiTietDonHang with lohang_sanpham_id and so_luong, TonKhoSanPham is restored in the same transaction",
      "order status is set to huy and commit is attempted with rollback on DB error"
    ],
    "payments": [
      "manual payment records can be created and updated",
      "MoMo Business flow creates payment URL and handles callback/return",
      "MoMo QR flow returns QR transfer info and requires manual confirmation",
      "successful payment totals can transition order from cho to thanh_toan"
    ],
    "inventory": [
      "batch creation creates stock snapshot rows",
      "inventory views aggregate per lot type",
      "alerts can be generated from low stock and expiry thresholds"
    ],
    "leafie": [
      "frontend posts message/context/history to backend proxy",
      "backend forwards to n8n webhook",
      "n8n owns AI logic and memory behavior"
    ]
  },
