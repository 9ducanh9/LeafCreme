  "architecture": {
    "backend": {
      "framework": "FastAPI",
      "entrypoint": "D:\\Leaf Creme\\app\\main.py",
      "db_module": "D:\\Leaf Creme\\app\\db.py",
      "model_module": "D:\\Leaf Creme\\app\\models.py",
      "structure": {
        "core": "config, auth dependencies, JWT security",
        "middleware": [
          "logging_middleware.py",
          "security_middleware.py"
        ],
        "routers": [
          "alerts.py",
          "analytics.py",
          "auth.py",
          "batches.py",
          "components.py",
          "gift_boxes.py",
          "leafie.py",
