    "name": "LeafCreme",
    "type": "full-stack bakery storefront and operations system",
    "stage": "working demo with real backend foundations and partial frontend/demo-only surfaces",
    "business_goal": "Manage bakery sales, inventory batches, FEFO allocation, gift boxes, vouchers, payments, and customer ordering in one system."
