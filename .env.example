# Copy to .env for local development. Never commit the real .env file.
# Full setup notes: see ENV_SETUP.md

# ---- Database ---------------------------------------------------------
# Used by both the app (app/db.py) and Alembic (alembic/env.py).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bakery

# ---- App / environment -------------------------------------------------
APP_ENV=development

# ---- JWT ----------------------------------------------------------------
# Generate a real value for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- URLs / CORS ----------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
# Comma-separated. Leave unset in dev to use the built-in localhost defaults.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Leafie / n8n chatbot -------------------------------------------------
# Backend only proxies to n8n; the assistant logic lives in the n8n workflow.
N8N_WEBHOOK_URL=

# ---- VNPay ----------------------------------------------------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_LOCALE=vn
VNPAY_CURR_CODE=VND
VNPAY_ORDER_TYPE=other

# ---- MoMo (Business API) ---------------------------------------------------
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=payWithMethod
MOMO_LANG=vi

# ---- MoMo QR (personal account, no business registration needed) ----------
MOMO_QR_PHONE=
MOMO_QR_ACCOUNT_NAME=
MOMO_QR_IMAGE_PATH=
