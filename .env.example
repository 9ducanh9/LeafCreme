# Copy to .env for local development. Never commit the real .env file.
# Copy this file to .env for local development. See README.md for setup.

# ---- Database ---------------------------------------------------------
# Used by both the app (app/db.py) and Alembic (alembic/env.py).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bakery

# ---- App / environment -------------------------------------------------
APP_ENV=development

# ---- JWT ----------------------------------------------------------------
# Generate a real value for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Authentication -----------------------------------------------------
# Keep `local` until Cognito is fully configured in both frontend and backend.
AUTH_PROVIDER=local
# COGNITO_REGION=ap-southeast-1
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=

# ---- URLs / CORS ----------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
# Comma-separated. Leave unset in dev to use the built-in localhost defaults.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Leafie / n8n chatbot -------------------------------------------------
# Backend only proxies to n8n; the assistant logic lives in the n8n workflow.
N8N_WEBHOOK_URL=

# ---- Operations Agent -------------------------------------------------
# Optional. Without it, /agent/chat still works but falls back to a
# deterministic summary of the same insights /agent/insights returns,
# clearly labeled as reduced-capability — see
# app/services/agent/agent_service.py::chat / _fallback_reply. Set it to
# have chat answers reasoned over by DeepSeek with real tool-calling
# (DeepSeek's API is OpenAI-compatible; `pip install openai` covers it).
DEEPSEEK_API_KEY=
# Override only for a self-hosted/proxy endpoint; defaults to
# https://api.deepseek.com otherwise.
DEEPSEEK_BASE_URL=

# Optional Langfuse tracing for the agent's LLM/tool-call loop (model,
# token usage, tool latency/errors). Without both keys set, tracing is a
# silent no-op — see app/services/agent/observability.py. Never required
# for the agent to function.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- VNPay ----------------------------------------------------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_LOCALE=vn
VNPAY_CURR_CODE=VND
VNPAY_ORDER_TYPE=other

# ---- MoMo (Business API) ---------------------------------------------------
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=payWithMethod
MOMO_LANG=vi

# ---- MoMo QR (personal account, no business registration needed) ----------
MOMO_QR_PHONE=
MOMO_QR_ACCOUNT_NAME=
MOMO_QR_IMAGE_PATH=
